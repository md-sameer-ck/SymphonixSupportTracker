# Copy to .env for local reference only — Netlify Functions read these from
# the Netlify UI's environment variables in production, and GitHub Actions
# reads its copies from repo Secrets. This file is never loaded automatically
# by anything in this repo; it's just a checklist. See README.md for how to
# obtain each value.

# --- Storage backend: Turso (recommended, fully free) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth: at least one of these two ---
ADMIN_PASSCODE=
# JSON map of person -> their own passcode, so writes are attributed by name
# automatically. Both this and ADMIN_PASSCODE can be set at once.
TEAM_PASSCODES={"Sameer":"","Asha":""}

GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=yourorg/symphonix-support-tracker

Q2_PORTAL_USER=
Q2_PORTAL_PASS=
Q2_LOGIN_URL=https://customerportal.q2.com/customerportal/s/login
Q2_CASE_LIST_URL=https://customerportal.q2.com/customerportal/s/support-cases?Case-filterId=All_Cases_Open_or_Closed

# --- Storage backend: Microsoft Graph / Excel (legacy, optional alternative
# to Turso — only needed if you specifically want the data in an Excel
# workbook on OneDrive/SharePoint instead) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=
MS_FILE_ID=
